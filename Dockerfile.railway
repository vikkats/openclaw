FROM node:24-bookworm-slim AS build

WORKDIR /app

RUN corepack enable

# Copy the full repository before installing. OpenClaw's pnpm lockfile uses
# patched dependencies and workspace/package metadata that may live outside the
# root package files, so a partial Docker cache layer can miss required inputs.
COPY . .
RUN if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile; else pnpm install; fi
RUN pnpm build && pnpm ui:build

FROM node:24-bookworm-slim AS runtime

ENV NODE_ENV=production
ENV HOME=/data
ENV OPENCLAW_HOME=/data/.openclaw
ENV OPENCLAW_CONFIG_PATH=/data/.openclaw/openclaw.json

WORKDIR /app
RUN corepack enable
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates unzip \
  && rm -rf /var/lib/apt/lists/*

COPY --from=build /app /app

RUN mkdir -p /data/.openclaw/workspace /data/backups/qdrant

EXPOSE 18789

CMD ["node", "scripts/ares-railway-start-wrapper.mjs"]
