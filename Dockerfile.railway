FROM node:24-bookworm-slim AS build

WORKDIR /app

RUN corepack enable

# Install dependency metadata first for Docker layer caching.
# pnpm-lock.yaml references patch files, so the patches directory must exist
# before `pnpm install --frozen-lockfile` runs.
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml* ./
COPY patches ./patches
RUN if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile; else pnpm install; fi

COPY . .
RUN pnpm build && pnpm ui:build

FROM node:24-bookworm-slim AS runtime

ENV NODE_ENV=production
ENV HOME=/data
ENV OPENCLAW_HOME=/data/.openclaw
ENV OPENCLAW_CONFIG_PATH=/data/.openclaw/openclaw.json

WORKDIR /app
RUN corepack enable

COPY --from=build /app /app

RUN mkdir -p /data/.openclaw/workspace /data/backups/qdrant

EXPOSE 18789

CMD ["node", "scripts/ares-railway-start.mjs"]
