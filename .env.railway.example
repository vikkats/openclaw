# Copy these into Railway Variables. Do not commit real secrets.

# Gateway
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_HOST=0.0.0.0
OPENCLAW_GATEWAY_TOKEN=change-me-long-random-token
OPENCLAW_WORKSPACE=/data/.openclaw/workspace

# Main companion model provider via NanoGPT's OpenAI-compatible API.
NANOGPT_API_KEY=your-nanogpt-key
NANO_GPT_BASE_URL=https://nano-gpt.com/api/v1
NANO_GPT_MODEL=moonshotai/kimi-k2.5:thinking
NANO_GPT_CONTEXT_TOKENS=131072
NANO_GPT_MAX_TOKENS=8192

# Telegram channel
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ALLOW_FROM=tg:123456789
TELEGRAM_DM_POLICY=allowlist

# Existing persistent Qdrant service
QDRANT_URL=https://your-qdrant-service.up.railway.app
QDRANT_API_KEY=your-qdrant-api-key-if-set
MEM0_COLLECTION=ares_mem0_memories
ARCHIVE_COLLECTION=mem_ares_velen

# Memory models / embeddings used by your mem0 layer or helper scripts
MEMORY_LLM_PROVIDER=nanogpt
MEMORY_LLM_MODEL=zai-org/GLM-5
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
OPENROUTER_API_KEY=your-openrouter-key

# Optional heartbeat. Set 0m to disable.
OPENCLAW_HEARTBEAT_EVERY=0m
OPENCLAW_HEARTBEAT_TARGET=last
